# =============================================================================
#  FounderHQ API — Environment Variables
#  Copy this file to .env and fill in real values before running the server.
#  NEVER commit .env to version control — it is already in .gitignore.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
# Set ENV=production on Render / Railway / AWS. All other values change behaviour
# based on this flag (docs visibility, DEBUG logging, secret validation).
ENV=development
PROJECT_NAME=FounderHQ-API
VERSION=1.0.0

# Set to false in production — disables /docs, /redoc, and stack traces in errors
DEBUG=true

PORT=8000
HOST=0.0.0.0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# DO NOT use * — wildcards allow any origin to make credentialed requests.
# Production example: CORS_ORIGINS=https://app.founderhq.com,https://founderhq.com
CORS_ORIGINS=["http://localhost:3000"]

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Obtain from Firebase Console → Project Settings → Service Accounts →
# Generate New Private Key. Store the values below from the downloaded JSON file.
# In production these MUST be real values — the app will refuse to start otherwise.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private key exactly as it appears in the JSON file (with \n line breaks)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters. NEVER use the example value in production.
JWT_SECRET_KEY=replace-this-with-a-strong-random-secret-min-32-chars
JWT_ALGORITHM=HS256
# Token expiry in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Number of requests allowed per window per IP address.
RATE_LIMIT_REQUESTS=100
# Window unit: second | minute | hour | day
RATE_LIMIT_WINDOW=minute
# Storage backend for rate limit counters.
# Single instance (dev/staging): memory://
# Multi-instance / horizontally scaled (production): redis://your-redis-host:6379/0
RATE_LIMIT_STORAGE_URI=memory://

# ── Brute-Force Login Protection ──────────────────────────────────────────────
# Number of failed attempts before an IP/email is temporarily locked out
MAX_LOGIN_ATTEMPTS=5
# How long (in minutes) a locked identifier must wait before retrying
LOGIN_LOCKOUT_MINUTES=15

# ── File Uploads ──────────────────────────────────────────────────────────────
# Maximum upload size in megabytes (default: 10 MB)
MAX_UPLOAD_SIZE_MB=10
# Comma-separated list of allowed MIME types
# Only PDF and DOCX are permitted by default
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
